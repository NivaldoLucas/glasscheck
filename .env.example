DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Deixe DB_ENGINE em branco (sqlite) para desenvolvimento local.
# Em produção/Docker, use postgres — os nomes POSTGRES_DB/USER/PASSWORD são os
# mesmos exigidos pela imagem oficial do Postgres, e o docker-compose.yml
# referencia essas mesmas variáveis (${POSTGRES_DB} etc.) tanto no serviço "db"
# quanto no "backend", então um valor aqui vale pros dois — sem duplicar senha.
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=glasscheck
POSTGRES_USER=glasscheck
POSTGRES_PASSWORD=troque-esta-senha
DB_HOST=db
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# N8N roda externamente (não faz parte deste docker-compose) — aponte para a URL da sua instância.
N8N_WEBHOOK_BASE_URL=https://troque-para-seu-n8n-externo/webhook
