DJANGO_SECRET_KEY=django-insecure-local-dev-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fica em branco de propósito: cai no sqlite (zero setup). Este arquivo é lido
# só pelo dev local via venv — o docker-compose usa o .env da raiz do projeto,
# não este aqui (é por isso que existem os dois).
DB_ENGINE=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
